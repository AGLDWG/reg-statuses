permalink: /retired.ttl
---
PREFIX cs: <https://linked.data.gov.au/def/reg-status/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX reg:  <http://purl.org/linked-data/registry#>
PREFIX : <https://linked.data.gov.au/def/reg-status/>


:retired
    a skos:Concept, reg:Status ;
    rdfs:isDefinedBy cs: ;
    owl:sameAs reg:statusRetired ;
    skos:prefLabel "retired"@en;
    skos:altlabel "withdrawn"@en;
    skos:definition "An entry that has been withdrawn from use.'"@en;
    skos:inScheme cs: ;
    skos:broader :deprecated ;
    skos:scopeNote "Previously approved for use but no longer" ;
    schema:color "#ad5b24" ;
.
